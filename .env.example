# Everything in this file is OPTIONAL. `npm run dev` works with zero env vars —
# the app runs entirely on the local in-browser quantum engine, localStorage
# progress tracking, and a rule-based tutor (see src/lib/quantumEngine.ts,
# src/lib/progress.ts, src/lib/tutor.ts).
#
# Set these only to switch to the production backend (Supabase auth/progress +
# FastAPI/Qiskit grading + AI chat) described in the root README's ADRs.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_FASTAPI_URL=
